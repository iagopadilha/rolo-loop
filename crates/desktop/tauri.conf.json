{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents Maestro",
  "identifier": "dev.iagopadilha.agentsmaestro",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Iago Boardman Padilha",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Unattended build loops for Claude Code",
    "longDescription": "Agents Maestro runs spec-driven build loops for Claude Code on your own subscription, with a guard hook on every tool call and a local panel to follow and answer the loop.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
