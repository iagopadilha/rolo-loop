{
  "version": 1,
  "shape": "Contract fixture of the network list (NET-01/NET-02), loaded by the app tests, the guard tests and the toolkit testenv checks. Each case: build the effective list = always-local hosts + built-in read list (unless builtin_read is false) + `entry`/`entries` (project entries, in order) with the `deny` host patterns (default none); env_names = names defined in .env.test (default none); then judge `request` {method, url, cred}: `allowed` is the expected verdict. method `*` = unknown method (URL literal in a script), `tcp` = non-HTTP connection (url tcp://host:port). `invalid` entries must be refused by the entry parser, the error text containing `reason_contains` (compared case-insensitively; implementations may word the rest freely).",
  "cases": [
    {"note": "exact host", "entry": "dev.example.com", "request": {"method": "GET", "url": "https://dev.example.com/x", "cred": false}, "allowed": true},
    {"note": "host is case-insensitive (request)", "entry": "dev.example.com", "request": {"method": "GET", "url": "https://DEV.Example.COM/x", "cred": false}, "allowed": true},
    {"note": "host is case-insensitive (entry)", "entry": "DEV.EXAMPLE.COM", "request": {"method": "GET", "url": "http://dev.example.com/", "cred": false}, "allowed": true},
    {"note": "other host", "entry": "dev.example.com", "request": {"method": "GET", "url": "https://other.example.com/", "cred": false}, "allowed": false},
    {"note": "wildcard one level", "entry": "*.example.com", "request": {"method": "GET", "url": "https://a.example.com/", "cred": false}, "allowed": true},
    {"note": "wildcard any depth", "entry": "*.example.com", "request": {"method": "GET", "url": "https://a.b.example.com/", "cred": false}, "allowed": true},
    {"note": "wildcard is not the bare domain", "entry": "*.example.com", "request": {"method": "GET", "url": "https://example.com/", "cred": false}, "allowed": false},
    {"note": "wildcard needs a dot boundary", "entry": "*.example.com", "request": {"method": "GET", "url": "https://evilexample.com/", "cred": false}, "allowed": false},
    {"note": "wildcard does not match a suffix trick", "entry": "*.example.com", "request": {"method": "GET", "url": "https://example.com.evil.org/", "cred": false}, "allowed": false},
    {"note": "exact host is not a prefix", "entry": "dev.example.com", "request": {"method": "GET", "url": "https://dev.example.com.evil.org/", "cred": false}, "allowed": false},
    {"note": "empty label does not match a wildcard", "entry": "*.example.com", "request": {"method": "GET", "url": "https://.example.com/", "cred": false}, "allowed": false},
    {"note": "trailing dot of the request host is ignored", "entry": "dev.example.com", "request": {"method": "GET", "url": "https://dev.example.com./x", "cred": false}, "allowed": true},
    {"note": "entry port matches", "entry": "dev.example.com:8443", "request": {"method": "GET", "url": "https://dev.example.com:8443/", "cred": false}, "allowed": true},
    {"note": "entry port differs from the default one", "entry": "dev.example.com:8443", "request": {"method": "GET", "url": "https://dev.example.com/", "cred": false}, "allowed": false},
    {"note": "entry port equals the scheme default (https)", "entry": "dev.example.com:443", "request": {"method": "GET", "url": "https://dev.example.com/", "cred": false}, "allowed": true},
    {"note": "entry port equals the scheme default (http)", "entry": "dev.example.com:80", "request": {"method": "GET", "url": "http://dev.example.com/", "cred": false}, "allowed": true},
    {"note": "no entry port = any port", "entry": "dev.example.com", "request": {"method": "GET", "url": "http://dev.example.com:9999/", "cred": false}, "allowed": true},
    {"note": "url without scheme is http (default port 80)", "entry": "dev.example.com:80", "request": {"method": "GET", "url": "dev.example.com/x", "cred": false}, "allowed": true},
    {"note": "url without scheme but with port", "entry": "dev.example.com:8443", "request": {"method": "GET", "url": "dev.example.com:8443/x", "cred": false}, "allowed": true},
    {"note": "protocol-relative url is http", "entry": "dev.example.com", "request": {"method": "GET", "url": "//dev.example.com/x", "cred": false}, "allowed": true},
    {"note": "wss defaults to 443", "entry": "dev.example.com:443", "request": {"method": "GET", "url": "wss://dev.example.com/socket", "cred": false}, "allowed": true},
    {"note": "scheme is case-insensitive", "entry": "dev.example.com", "request": {"method": "GET", "url": "HTTPS://DEV.example.com/X", "cred": false}, "allowed": true},
    {"note": "path prefix equals the path", "entry": "dev.example.com/catalog", "request": {"method": "GET", "url": "https://dev.example.com/catalog", "cred": false}, "allowed": true},
