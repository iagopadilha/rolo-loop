    {"note": "default methods: HEAD allowed", "entry": "dev.example.com", "request": {"method": "HEAD", "url": "https://dev.example.com/x", "cred": false}, "allowed": true},
    {"note": "explicit method allowed", "entry": "dev.example.com POST", "request": {"method": "POST", "url": "https://dev.example.com/x", "cred": false}, "allowed": true},
    {"note": "explicit method replaces the default", "entry": "dev.example.com POST", "request": {"method": "GET", "url": "https://dev.example.com/x", "cred": false}, "allowed": false},
