    {"note": "trailing slash in the entry keeps the boundary", "entry": "dev.example.com/catalog/", "request": {"method": "GET", "url": "https://dev.example.com/catalogx", "cred": false}, "allowed": false},
    {"note": "prefix only at the start of the path", "entry": "dev.example.com/catalog", "request": {"method": "GET", "url": "https://dev.example.com/x/catalog", "cred": false}, "allowed": false},
    {"note": "backslash is a separator", "entry": "dev.example.com/catalog", "request": {"method": "GET", "url": "https://dev.example.com/catalog\\..\\backplan", "cred": false}, "allowed": false},
    {"note": "backslash in the authority is refused", "entry": "evil.com", "request": {"method": "GET", "url": "https://dev.example.com\\@evil.com/catalog", "cred": false}, "allowed": false},
    {"note": "userinfo does not change the host", "entry": "dev.example.com", "request": {"method": "GET", "url": "https://user:pw@dev.example.com/x", "cred": false}, "allowed": true},
    {"note": "userinfo trick resolves to the real host", "entry": "dev.example.com", "request": {"method": "GET", "url": "https://dev.example.com@evil.com/", "cred": false}, "allowed": false},
    {"note": "control character in the url", "entry": "dev.example.com", "request": {"method": "GET", "url": "https://dev.example.com/x\ny", "cred": false}, "allowed": false},
    {"note": "root path against a prefix", "entry": "dev.example.com/catalog", "request": {"method": "GET", "url": "https://dev.example.com/", "cred": false}, "allowed": false},
