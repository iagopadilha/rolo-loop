    {"note": "if-missing: name undefined -> active", "entry": "dev.example.com/auth/login POST cred if-missing=ACCESS_TOKEN", "request": {"method": "POST", "url": "https://dev.example.com/auth/login", "cred": true}, "env_names": [], "allowed": true},
    {"note": "if-missing: name defined -> inactive", "entry": "dev.example.com/auth/login POST cred if-missing=ACCESS_TOKEN", "request": {"method": "POST", "url": "https://dev.example.com/auth/login", "cred": true}, "env_names": ["ACCESS_TOKEN"], "allowed": false},
